# Core storage and model
KB_DSN=postgresql://carrier_kb:carrier_kb_dev_only@localhost:55432/carrier_kb
OPENAI_API_KEY=
EMBED_MODEL=text-embedding-3-large
ANSWER_MODEL=gpt-5-mini

# Carrier Hub integration. The service validates an internal Firebase token by asking
# Carrier Hub's existing user_info endpoint; it never trusts roles sent by the browser.
CARRIER_HUB_API_BASE_URL=https://carrier-onboarding.lohi.ai

# Public enrollment capability tokens are issued by Carrier Hub, not by this service.
# Use a separate, rotated shared secret or replace this lane with an asymmetric issuer.
KB_CAPABILITY_ISSUER=carrier-onboarding-server
KB_CAPABILITY_AUDIENCE=carrier-onboarding-kb
KB_CAPABILITY_SECRET=

# Ingestion credentials. Configure only the adapters in your approved source registry.
GOOGLE_APPLICATION_CREDENTIALS=
SLACK_BOT_TOKEN=
LOHI_READ_DSN=
